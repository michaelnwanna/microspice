voltage_source("V1", supply, ground, 5V)
resistor("R1", supply, output, 1kohm)
diode("D1", output, ground, saturation=1pA, ideality=1)
dc("bias")
observe("bias", voltage(output), current("R1"))
measure("forward_voltage", from="bias", value=voltage(output))
check("forward biased", forward_voltage > 500mV)
check("below 800 mV", forward_voltage < 800mV)
sweep("curve", source="V1", start=0V, stop=5V, step=100mV)
observe("curve", voltage(output), current("V1"))