function(expect_exit expected)
  execute_process(COMMAND "${CLI}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${ARGN}\nstdout: ${output}\nstderr: ${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
  set(last_error "${error}" PARENT_SCOPE)
endfunction()

expect_exit(0 check "${EXAMPLES}/voltage_divider.msim")
if(NOT last_output MATCHES "Valid: 3 components, 1 analyses")
  message(FATAL_ERROR "Compile-only output: ${last_output}")
endif()
expect_exit(0 run "${EXAMPLES}/voltage_divider.msim")
if(NOT last_output MATCHES "midpoint = 5 V" OR NOT last_error MATCHES "PASS divider output")
  message(FATAL_ERROR "Human output/diagnostics separation")
endif()
expect_exit(0 run "${EXAMPLES}/diode_bias.msim" --analysis curve --csv curve)
if(NOT last_output MATCHES "^source_V,\"voltage\\(output\\) \\[V\\]" OR last_output MATCHES "PASS|SKIP|Analysis")
  message(FATAL_ERROR "CSV contamination: ${last_output}")
endif()
if(NOT last_error MATCHES "SKIP measurement 'forward_voltage'" OR NOT last_error MATCHES "SKIP check")
  message(FATAL_ERROR "Selection dependency reporting: ${last_error}")
endif()
expect_exit(0 run "${FIXTURES}/quoted.msim" --csv bias)
if(NOT last_output MATCHES "current\\(R,\"\"1\\)" OR NOT last_output MATCHES "voltage\\(output,ground\\)")
  message(FATAL_ERROR "CSV quoting: ${last_output}")
endif()
expect_exit(3 run "${FIXTURES}/failed_checks.msim")
if(NOT last_error MATCHES "FAIL first" OR NOT last_error MATCHES "FAIL second" OR NOT last_error MATCHES "PASS third")
  message(FATAL_ERROR "Did not collect all checks: ${last_error}")
endif()
expect_exit(3 run "${FIXTURES}/failed_checks.msim" --csv bias)
if(last_output MATCHES "FAIL" OR NOT last_output MATCHES "^sample,")
  message(FATAL_ERROR "Check failure CSV separation")
endif()
expect_exit(1 check "${FIXTURES}/invalid.msim")
if(NOT last_error MATCHES "invalid.msim:2:28: error: expected ohm" OR NOT last_error MATCHES "\\^")
  message(FATAL_ERROR "Source diagnostic: ${last_error}")
endif()
if(NOT last_output STREQUAL "")
  message(FATAL_ERROR "Compile error wrote stdout")
endif()
expect_exit(1 run "${FIXTURES}/singular.msim")
if(NOT last_error MATCHES "analysis 'bad'" OR NOT last_output STREQUAL "")
  message(FATAL_ERROR "Solver diagnostic/result suppression")
endif()
expect_exit(0 check "${FIXTURES}/no_analysis.msim")
expect_exit(1 run "${FIXTURES}/no_analysis.msim")
expect_exit(1 run "${FIXTURES}/nonconvergent.msim")
if(NOT last_error MATCHES "did not converge" OR last_error MATCHES "PASS|FAIL must not run" OR NOT last_output STREQUAL "")
  message(FATAL_ERROR "Nonconvergence exposed successful checks/results: ${last_error}")
endif()
expect_exit(2)
expect_exit(2 nope "${EXAMPLES}/voltage_divider.msim")
expect_exit(2 run "${FIXTURES}/missing.msim")
expect_exit(2 run "${FIXTURES}")
expect_exit(2 check "${EXAMPLES}/voltage_divider.msim" --csv bias)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --bad)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --analysis)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --analysis bias --analysis bias)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --csv bias --csv bias)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --analysis absent)
expect_exit(2 run "${EXAMPLES}/voltage_divider.msim" --csv absent)
expect_exit(2 run "${EXAMPLES}/diode_bias.msim" --analysis bias --csv curve)
expect_exit(0 --help)